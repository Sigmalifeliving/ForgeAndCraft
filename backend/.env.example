# JWT Secret - CHANGE THIS in production
SECRET_KEY=change-this-in-production-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./forgecraft.db

# Mistral Audio Director - leave empty to use built-in demo plans
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT=120

# 3D Settings
THREE_D_ENGINE=triposr
THREE_D_REFERENCE_ENGINE=pollinations
THREE_D_DEVICE=auto
THREE_D_MC_RESOLUTION=192
THREE_D_CHUNK_SIZE=16384
THREE_D_SD_STEPS=2
THREE_D_REMBG=true
THREE_D_SD_MODEL_ID=stabilityai/sd-turbo
THREE_D_TRIPOSR_MODEL_ID=stabilityai/TripoSR
